{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sideglance",
  "version": "0.4.0",
  "identifier": "app.sideglance.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "AI usage and notifications on a Divoom Ditoo Pro",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 230
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 230
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/msi-banner.bmp",
        "dialogImagePath": "installer/msi-dialog.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MDVFQ0VGNzJCOTE4OEYKUldTUEdMbHk3K3dGcE02UDRIWDlEYy81ZTN4WVdyZWJXWlJsYzM3eUM0eXhCQWV6MEcrVktybDgK",
      "endpoints": [
        "https://github.com/maxexq/sideglance-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
